# ---- AI advisor (Claude API) ----
# Without a key the advisor runs in offline mode (rule-based replies).
ANTHROPIC_API_KEY=
# ADVISOR_MODEL=claude-opus-5
# GUARD_MODEL=claude-opus-5        # model for the finance-only topic gate
# ADVISOR_EFFORT=medium            # low | medium | high

# ---- Security ----
# 32-byte master key, base64. REQUIRED in production. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=
# NODE_ENV=production              # enables Secure / __Host- cookies
# SESSION_IDLE_MINUTES=30
# TRUST_PROXY=1                    # set when behind a reverse proxy (for correct client IPs)
# CORS_ORIGINS=https://my-other-app.example   # origins allowed to call /api/v1 from a browser

# ---- Server ----
# PORT=8787
# DATA_DIR=./server/data
